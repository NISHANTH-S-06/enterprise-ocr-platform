APP_NAME=OCR Platform
APP_ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1

SECRET_KEY=replace-with-a-random-64-character-production-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

DATABASE_URL=postgresql+asyncpg://ocr:replace-with-strong-password@db:5432/ocrdb
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

UPLOAD_DIR=uploads
OUTPUT_DIR=output
TEMPLATES_DIR=templates_store
MAX_FILE_SIZE_MB=50
MAX_PDF_PAGES=2
OCR_TIMEOUT_SECONDS=60

LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=https://ocr.example.com
ALLOW_PUBLIC_REGISTRATION=false

AI_FALLBACK_ENABLED=false
GEMINI_API_KEY=
AI_FALLBACK_MODEL=gemini-1.5-flash
AI_FALLBACK_TIMEOUT_SECONDS=10
AI_FALLBACK_MIN_CONFIDENCE=0.75
AI_FALLBACK_REGEX_PROTECT_CONFIDENCE=0.90

FLAGS_use_mkldnn=0
FLAGS_enable_pir_api=0
OMP_NUM_THREADS=1
PADDLE_CPP_LOGLEVEL=3

TESSERACT_CMD=
